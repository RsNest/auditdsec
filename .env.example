# Telegram bot token from @BotFather.
AUDITDSEC_TG_TOKEN=123456789:AA...

# Chat ids allowed to talk to the bot, comma separated. The bot answers nobody
# else. Get yours by writing to the bot and opening:
#   https://api.telegram.org/bot<TOKEN>/getUpdates
AUDITDSEC_TG_CHAT_ID=111222333

# simple (one VPS, only important alerts) or pro (every event, longer retention)
AUDITDSEC_PROFILE=simple

# ru or en
AUDITDSEC_LANG=ru

# Host name shown in the alerts. Leave it empty and the agent reads the host's
# own /etc/hostname, which docker-compose.yml mounts for exactly this reason;
# set it to override that with a friendlier name.
AUDITDSEC_HOST=

# Time zone used in the timestamps of the messages.
TZ=Europe/Moscow

# Ban backend: none (default) records decisions without touching the host;
# nftables actually blocks, and needs deploy/compose.enforce.yml for the
# capability and the host network namespace.
# AUDITDSEC_BAN_BACKEND=nftables
# AUDITDSEC_BAN_DRY_RUN=1

# Debug mode: 1 logs every audit line, why each record was ignored and the
# decision behind every alert. Use it while setting the agent up, then remove
# the line and restart. The /debug command in the chat shows the current state.
# AUDITDSEC_DEBUG=1

# ---------------------------------------------------------------------------
# Web panel. Do not edit this by hand: run ./install.sh. It asks how the panel
# should be reached (domain, public IP, self-signed IP or SSH tunnel), hashes
# the password, writes the lines below (values single-quoted so Compose leaves
# the $ in the hash alone), starts everything and prints a link only after the
# sign-in page and certificate have been checked. Re-running keeps your data.
#
# PANEL_MODE=domain            # domain | ip | selfsigned | tunnel
# PANEL_SITE=panel.example.com # domain or public IP (PANEL_DOMAIN is still read)
# PANEL_EMAIL=you@example.com  # Let's Encrypt expiry notices (domain mode)
# PANEL_CADDYFILE=./deploy/Caddyfile
# PANEL_ACME=staging           # staging | production (domain and ip modes)
# PANEL_ACME_SUFFIX=-staging   # picks the staging volumes; empty for production
# PANEL_ACME_URL=...           # the ACME directory in use
# PANEL_HSTS=max-age=0         # set only on staging, so a browser can still click through
# PANEL_PORT=9477              # agent port on the host's loopback
# AUDITDSEC_WEB=1
# AUDITDSEC_WEB_LOGIN=admin
# AUDITDSEC_WEB_PASSWORD_HASH='pbkdf2-sha256$310000$...'   # never the password
#
# Dry run first, then the real CA, nothing deleted on the way:
#   ./install.sh --mode domain --site panel.example.com --email you@example.com --staging
#   ./install.sh --production
