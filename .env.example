# Telegram bot token from @BotFather.
AUDITDSEC_TG_TOKEN=123456789:AA...

# Chat ids allowed to talk to the bot, comma separated. The bot answers nobody
# else. Get yours by writing to the bot and opening:
#   https://api.telegram.org/bot<TOKEN>/getUpdates
AUDITDSEC_TG_CHAT_ID=111222333

# Deprecated preset of starting values: simple (one VPS, only important alerts)
# or pro (every event, longer retention). Any explicit setting wins over it.
AUDITDSEC_PROFILE=simple

# ru or en
AUDITDSEC_LANG=ru

# Installer only: the first interactive run asks Russian / English.
# Saved by install.sh; independent of AUDITDSEC_LANG and the UI language.
# PANEL_INSTALLER_LANG=ru

# Host name shown in the alerts. Leave it empty and the agent reads the host's
# own /etc/hostname, which docker-compose.yml mounts for exactly this reason;
# set it to override that with a friendlier name.
AUDITDSEC_HOST=

# Time zone used in the timestamps of the messages.
TZ=Europe/Moscow

# Ban backend: none (default) records decisions without touching the host;
# nftables actually blocks, and needs deploy/compose.enforce.yml for the
# capability and the host network namespace.
# AUDITDSEC_BAN_BACKEND=nftables
# AUDITDSEC_BAN_DRY_RUN=1

# Debug mode: 1 logs every audit line, why each record was ignored and the
# decision behind every alert. Use it while setting the agent up, then remove
# the line and restart. The /debug command in the chat shows the current state.
# AUDITDSEC_DEBUG=1

# ---------------------------------------------------------------------------
# Web panel. Do not edit this by hand: run ./install.sh. It asks where the
# panel opens (a domain or this server's public IP), checks public DNS, picks
# the public HTTPS port (443, else a random high port, or the one you give),
# checks it from ANOTHER machine through your RemoteProbe provider, gets a
# trusted certificate, starts everything and prints the link only after those
# checks passed. Values are single-quoted so Compose leaves any $ alone.
# Re-running keeps your data, certificates and the credentials set in the panel.
#
# PANEL_MODE=domain             # domain | ip   (tunnel | selfsigned: development only)
# PANEL_SITE=panel.example.com  # the domain or the public IP (PANEL_DOMAIN is still read)
# PANEL_SITE_ADDR=...           # the same, as written in an address (IPv6 in brackets)
# PANEL_PUBLIC_IP=203.0.113.10  # only when the address is not on an interface (NAT)
# PANEL_HTTPS_PORT=443          # the PUBLIC HTTPS port of the panel
# PANEL_PUBLIC_URL=https://panel.example.com    # the link, with the port unless 443
# PANEL_UPSTREAM_PORT=9477      # the agent's own port on loopback; was PANEL_PORT
# PANEL_EMAIL=you@example.com   # Let's Encrypt expiry notices
# PANEL_CADDYFILE=./deploy/Caddyfile
# PANEL_PROBE_URL=https://probe.example.net:8443   # RemoteProbe on another machine
# PANEL_PROBE_TOKEN_FILE=/root/probe.token         # the PATH of its token, never the token
# PANEL_PROBE_CACERT=/root/probe-ca.pem            # only for a privately signed provider
# PANEL_ACME=production         # production | staging (staging: --staging, never "published")
# PANEL_ACME_SUFFIX=-staging    # picks the staging volumes; empty for production
# PANEL_ACME_URL=...            # the ACME directory in use
# PANEL_HSTS=max-age=0          # set only on staging, so a browser can still click through
# AUDITDSEC_WEB=1
#
# First sign-in: admin / admin. It opens only the mandatory setup screen, where
# the owner chooses the login and password. They are stored hashed in the
# agent's state volume, not here, and win over AUDITDSEC_WEB_LOGIN /
# AUDITDSEC_WEB_PASSWORD_HASH (older installations: those are migrated once).
#
#   ./install.sh --mode domain --site panel.example.com --email you@example.com \
#                --probe-url https://probe.example.net:8443 --probe-token-file /root/probe.token
#   ./install.sh --mode ip --site 203.0.113.10 --https-port 27431 --probe-url ... --probe-token-file ...
