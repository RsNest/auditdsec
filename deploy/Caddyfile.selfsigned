# Caddy in front of the panel with a certificate Caddy issues itself.
#
# Use this only when the panel cannot get a real certificate: no domain, and
# an address Let's Encrypt will not certify — a private or NAT address, or a
# server whose port 80 cannot be opened.
#
# The traffic is encrypted, which is the point: the sign-in password must not
# cross the network readable. But no browser knows the issuer, so every
# browser shows a warning the first time, and nothing distinguishes that
# warning from the one a real attacker would cause. Prefer a domain, or a
# public address with deploy/Caddyfile.acme-ip, whenever either is possible.
#
# Only the panel's port (PANEL_HTTPS_PORT, 443 by default) has to be open: there is no challenge to answer.

{
	admin 127.0.0.1:2019
	# HTTP/3 would need the same port over UDP as well, and a firewall rule for it.
	# The panel does not need it.
	servers {
		protocols h1 h2
	}
	# A browser sends no server name when the URL is an IP address, and Caddy
	# would then pick the certificate by the address the client connected to,
	# which is wrong behind NAT and when probing 127.0.0.1. Name it explicitly.
	default_sni {$PANEL_SITE}
}

https://{$PANEL_SITE_ADDR}:{$PANEL_HTTPS_PORT:443} {
	tls internal

	encode zstd gzip

	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		-Server
	}

	reverse_proxy {$PANEL_UPSTREAM} {
		header_up X-Forwarded-For {remote_host}
	}

	log {
		output file /var/log/caddy/panel.log {
			roll_size 10MiB
			roll_keep 3
		}
		format json
	}
}
