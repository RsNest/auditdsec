# systemd unit for the binary install (the fallback when Docker is not used).
#
#   sudo install -m 0755 auditdsec /usr/local/bin/auditdsec
#   sudo install -d -m 0750 /etc/auditdsec /var/lib/auditdsec /var/log/auditdsec
#   sudo install -m 0640 config.example.yaml /etc/auditdsec/auditdsec.yaml
#   sudo cp deploy/auditdsec.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now auditdsec
#
# Put the token in /etc/auditdsec/auditdsec.env (mode 0600) rather than in the
# unit file, so it does not show up in `systemctl cat`.

[Unit]
Description=auditdsec — auditd in plain language, with Telegram alerts
Documentation=https://github.com/RsNest/auditdsec
After=network-online.target auditd.service
Wants=network-online.target

[Service]
Type=simple
# Root is required to read /var/log/audit/audit.log (mode 0600), but every
# capability is dropped and the filesystem is read-only apart from the state.
User=root
EnvironmentFile=-/etc/auditdsec/auditdsec.env
ExecStart=/usr/local/bin/auditdsec run -config /etc/auditdsec/auditdsec.yaml
Restart=always
RestartSec=5s

CapabilityBoundingSet=
AmbientCapabilities=
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryMax=64M
TasksMax=64
ReadWritePaths=/var/lib/auditdsec /var/log/auditdsec
ReadOnlyPaths=/var/log/audit

[Install]
WantedBy=multi-user.target
