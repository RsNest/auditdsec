# Caddy in front of the panel on this server's own address, with no domain.
#
# Let's Encrypt does not issue certificates for bare addresses, so Caddy makes
# one itself. The traffic is still encrypted — which is the point, the sign-in
# password must not cross the network readable — but the browser does not know
# the certificate's issuer, so it shows a warning the first time. Accept it
# once and the panel works normally.
#
# Select it in .env:
#   PANEL_CADDYFILE=./deploy/Caddyfile.ip
#   PANEL_SITE=203.0.113.4        this server's address
#
# Only port 443 has to be open: nothing here listens on 80, because there is
# no certificate challenge to answer.
#
# With a domain, deploy/Caddyfile gives a certificate with no warning at all.

https://{$PANEL_SITE} {
	tls internal

	encode zstd gzip

	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		-Server
	}

	reverse_proxy {$PANEL_UPSTREAM} {
		header_up X-Forwarded-For {remote_host}
	}

	log {
		output file /var/log/caddy/panel.log {
			roll_size 10MiB
			roll_keep 3
		}
		format json
	}
}
