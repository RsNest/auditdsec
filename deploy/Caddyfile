# Caddy in front of the panel, on a domain name, with a real certificate from
# Let's Encrypt. Mounted by deploy/compose.public.yml.
#
# From the environment:
#   PANEL_SITE      the domain the certificate is issued for
#   PANEL_EMAIL     where Let's Encrypt sends expiry warnings
#   PANEL_UPSTREAM  where the agent listens, 127.0.0.1:9477
#
# The name must already point at this server and ports 80 and 443 must be
# open, or the certificate cannot be issued. Check with:
#   auditdsec check-domain panel.example.com
#
# For a server without a domain, use deploy/Caddyfile.ip instead.

{
	email {$PANEL_EMAIL}
	# While testing, use the staging CA so a mistake does not burn through
	# Let's Encrypt's rate limit for the real certificate.
	# acme_ca https://acme-staging-v02.api.letsencrypt.org/directory
}

{$PANEL_SITE} {
	encode zstd gzip

	header {
		# Served over TLS from here on, so the browser should never try plain
		# HTTP for this name again.
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		-Server
	}

	# The agent sets its own content policy, so nothing here needs to.
	reverse_proxy {$PANEL_UPSTREAM} {
		header_up X-Forwarded-For {remote_host}
	}

	log {
		output file /var/log/caddy/panel.log {
			roll_size 10MiB
			roll_keep 3
		}
		format json
	}
}
