# Caddy in front of the panel, on a domain name. Caddy gets the certificate
# from Let's Encrypt itself and renews it on its own.
#
# From the environment:
#   PANEL_SITE      the domain the certificate is issued for
#   PANEL_EMAIL     where Let's Encrypt sends expiry warnings
#   PANEL_UPSTREAM  where the agent listens, 127.0.0.1:9477
#
#   PANEL_ACME_URL  the ACME directory; Let's Encrypt production when unset.
#                   ./install.sh --staging points it at the staging CA.
#   PANEL_HSTS      the Strict-Transport-Security value. Staging certificates
#                   are untrusted, and HSTS would take away the browser's
#                   "continue anyway" button, so staging sets max-age=0.
#
# The panel is served on PANEL_HTTPS_PORT (443 unless the installer chose
# another; that is the PUBLIC port, not the agent's own). Port 80 must be open
# for the certificate challenge and redirects to the panel's address; with the
# panel on 443 the challenge can also arrive there. PANEL_SITE_ADDR is the name
# as it is written in an address (an IPv6 address in brackets).
#
# ./install.sh writes all of this; it is here to be read and edited, not
# copied by hand.

{
	email {$PANEL_EMAIL}
	acme_ca {$PANEL_ACME_URL:https://acme-v02.api.letsencrypt.org/directory}
	admin 127.0.0.1:2019
	# HTTP/3 would need the same port over UDP as well, and a firewall rule for it.
	# The panel does not need it.
	servers {
		protocols h1 h2
	}
}

{$PANEL_SITE_ADDR}:{$PANEL_HTTPS_PORT:443} {
	encode zstd gzip

	header {
		# Served over TLS from here on, so the browser should never try plain
		# HTTP for this name again.
		Strict-Transport-Security "{$PANEL_HSTS:max-age=31536000}"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		-Server
	}

	# The agent sets its own content policy, so nothing here needs to.
	reverse_proxy {$PANEL_UPSTREAM} {
		header_up X-Forwarded-For {remote_host}
	}

	log {
		output file /var/log/caddy/panel.log {
			roll_size 10MiB
			roll_keep 3
		}
		format json
	}
}
